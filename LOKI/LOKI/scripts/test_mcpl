#!/usr/bin/env bash

# A simulation from a McStas MCPL file (with physics: only which outputs are filled is pinned) and its analysis.
# Each step must succeed (its output is in <step>.log); the log of the test is a summary of the output files
# (LOKI.OutputSummary: histograms, detection events, mask files).

run() { local name=$1; shift; "$@" > $name.log 2>&1 || { tail -40 $name.log; echo "TEST FAILED: $name"; exit 1; }; }
run sim sb_loki_sim event_gen=mcpl input_file=$(sb_core_finddata LOKI lokiMcstas_testFile.mcpl.gz)
run ana sb_loki_ana lokisim.griff
python3 -m LOKI.OutputSummary --nonzero-only
