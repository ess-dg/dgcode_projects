#!/usr/bin/env bash

# The masking simulation (geantinos) and analysis with the calibration slit masks.
# Each step must succeed (its output is in <step>.log); the log of the test is a summary of the output files
# (LOKI.OutputSummary: histograms, detection events, mask files).

run() { local name=$1; shift; "$@" > $name.log 2>&1 || { tail -40 $name.log; echo "TEST FAILED: $name"; exit 1; }; }
run sim sb_lokimasking_sim rear_detector_distance_m=5 aiming_straw_pixel_number=1024 analysis_straw_pixel_number=512 beamstop_id=0 with_calibration_slits=True -lPL_Empty
run ana sb_lokimasking_ana loki_masking.griff
python3 -m LOKI.OutputSummary
