#!/usr/bin/env python3

# The analysis uses the bank placements of the simulation: the production launchers (sb_loki_sim,
# sb_lokimasking_sim) record the text of the bank calibration file in the user data, and the analysis programs
# (sb_loki_ana, sb_lokimasking_ana) use that text, not the file.
#
# A copy of the 2026-September-SAM-606 calibration (named 'mycal') is given by its path. After the simulation the
# file is changed (bank 2 moved by 50 mm along its tubes) and then removed; the analysis must give the same
# detection events / mask file in all three cases. That the change would matter is shown with the conversion points
# of the GRIFF file: their pixel ids with the changed placement differ from those with the original one.
# Also checked: the detection file header records the calibration name and text.

import os
import shutil
import subprocess
import sys
import mcpl
import GriffDataRead
import G4GeoLoki.LokiAimHelper as LokiAim
import G4GeoLokiTests.TestUtils as TU
from G4GeoLokiTests.testhelpers import Checker, captured_fd_output

chk = Checker()
N = 16
SAM606 = '2026-September-SAM-606'

def run(command):
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if result.returncode != 0:
        print(result.stdout[-3000:])
        print(f'TEST FAILED: {" ".join(command)}')
        sys.exit(1)
    return result.stdout

def moved_bank_2(text, shift_mm):
    """The calibration text with the front face centre F of bank 2 moved along its tubes (u)."""
    lines = []
    for line in text.splitlines():
        words = line.split()
        if words[:2] == ['bank', '2']:
            values = [float(v) for v in words[2:]]
            values[0:3] = [values[i] + shift_mm * values[3 + i] for i in range(3)]
            line = 'bank 2 ' + ' '.join(repr(v) for v in values)
        lines.append(line)
    return '\n'.join(lines) + '\n'

def conversion_pixels(griff, calibration_path):
    """Pixel ids of the Converter exit points of the primary particles (GRIFF), with a calibration file."""
    pc = TU.PixelCalc(5000.0, N, 9, calibration_path)
    with captured_fd_output():
        dr = GriffDataRead.GriffDataReader(griff)
    ids = []
    while dr.loopEvents():
        for trk in dr.primaryTracks:
            for seg in trk.segments:
                if seg.volumeName() == 'Converter':
                    st = seg.lastStep()
                    ids.append(pc.getPixelId(seg.volumeCopyNumber(5), seg.volumeCopyNumber(3), seg.volumeCopyNumber(1),
                                             st.postGlobalX(), st.postGlobalY(), st.postGlobalZ()))
    return ids

original = LokiAim.bankCalibrationText(SAM606).replace(f'name {SAM606}', 'name mycal')
moved = moved_bank_2(original, 50.0)

def analyse_three_times(command, outputs):
    """The analysis with the original file, the changed file and without the file: the outputs (bytes)."""
    results = []
    for case in ('original', 'changed', 'removed'):
        if case == 'original':
            open('mycal.txt', 'w').write(original)
        elif case == 'changed':
            open('mycal.txt', 'w').write(moved)
        else:
            os.remove('mycal.txt')
        run(command)
        results.append(tuple(open(name, 'rb').read() for name in outputs))
    open('mycal.txt', 'w').write(original)
    return results

for directory in ('run_loki', 'run_masking'):
    shutil.rmtree(directory, ignore_errors=True)
    os.makedirs(directory)

print('=' * 90)
print('Neutrons (sb_loki_sim flood source at bank 2, QGSP_BIC_HP) -> sb_loki_ana')
os.chdir('run_loki')
open('mycal.txt', 'w').write(original)
run(['sb_loki_sim', '-lQGSP_BIC_HP', '-n300', '--seed=1234', 'event_gen=flood', 'aiming_bank_id=2',
     f'analysis_straw_pixel_number={N}', 'bank_calibration=./mycal.txt'])
results = analyse_three_times(['sb_loki_ana', 'lokisim.griff'], ['detectionEvents.mcpl'])
file = mcpl.MCPLFile('detectionEvents.mcpl')
chk.check(file.nparticles > 0, 'no detection events')
print(f'  detection events: > 0: {file.nparticles > 0}')
print(f'  the same detection events with the original, the changed and without the calibration file: '
      f'{results[0] == results[1] == results[2]}')
chk.check(results[0] == results[1] == results[2], 'the analysis does not use the recorded calibration')
header = {k: (v.decode() if isinstance(v, bytes) else v) for k, v in file.blobs.items()}
chk.check(header.get('bank_calibration') == './mycal.txt' and header.get('bank_calibration_text') == original,
          'the detection file header does not record the calibration')
print(f'  detection file header: bank_calibration={header.get("bank_calibration")}, the text of the calibration: '
      f'{header.get("bank_calibration_text") == original}')
open('moved.txt', 'w').write(moved.replace('name mycal', 'name moved'))
differ = sum(a != b for a, b in zip(conversion_pixels('lokisim.griff', os.path.abspath('mycal.txt')),
                                    conversion_pixels('lokisim.griff', os.path.abspath('moved.txt'))))
chk.check(differ > 0, 'the changed calibration would not change any pixel id (the test can not fail)')
print(f'  conversion points with another pixel id for the changed calibration: > 0: {differ > 0}')
os.chdir('..')

print('=' * 90)
print('Geantinos (sb_lokimasking_sim at bank 2) -> sb_lokimasking_ana')
os.chdir('run_masking')
open('mycal.txt', 'w').write(original)
first = LokiAim.AimHelper(5000.0, N).getBankPixelOffset(2)
run(['sb_lokimasking_sim', '-lPL_Empty', '-n672', 'aiming_bank_id=2', f'aiming_pixel_id_min={first}',
     f'aiming_straw_pixel_number={N}', f'analysis_straw_pixel_number={N}', 'bank_calibration=./mycal.txt'])
results = analyse_three_times(['sb_lokimasking_ana', 'loki_masking.griff'], ['bank2_maskFile.xml'])
print(f'  the same mask file with the original, the changed and without the calibration file: '
      f'{results[0] == results[1] == results[2]}')
chk.check(results[0] == results[1] == results[2], 'the masking analysis does not use the recorded calibration')
open('moved.txt', 'w').write(moved.replace('name mycal', 'name moved'))
differ = sum(a != b for a, b in zip(conversion_pixels('loki_masking.griff', os.path.abspath('mycal.txt')),
                                    conversion_pixels('loki_masking.griff', os.path.abspath('moved.txt'))))
chk.check(differ > 0, 'the changed calibration would not change any pixel id (the test can not fail)')
print(f'  Converter exit points with another pixel id for the changed calibration: > 0: {differ > 0}')
os.chdir('..')

chk.finish()
