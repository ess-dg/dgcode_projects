#!/usr/bin/env python3

# End-to-end test of the production masking chain (geantinos, no physics, fast):
#   sb_lokimasking_sim (MaskingSourceGen aims one geantino per pixel centre,
#   using AimHelper, at consecutive pixel ids starting at aiming_pixel_id_min)
#   -> Geant4 tracking in the GeoBCSBanks geometry
#   -> sb_lokimasking_ana (pixel id from Converter segments: copy numbers +
#      PixelatedBanks::getPixelId; MaskFileCreator writes the mask file).
#
# Checks: every aimed pixel id is among the pixels entered by the geantinos
# (h_geantino_pixel_enter histogram of the analysis), and the mask file is the
# exact complement (ids+1) of the "entered without passing a mask" histogram.
# The full lists of entered pixel ids are printed to pin the current behaviour
# (they also contain the pixels of other straws crossed on the way).
#
# Small pixel numbers (4 per straw) keep the mask files and histograms small.

import os
import re
import subprocess
import sys
import numpy as np
import SimpleHists as sh
import G4GeoLoki.LokiAimHelper as LokiAim
import G4GeoLokiTests.TestUtils as TU
from G4GeoLokiTests.testhelpers import Checker

chk = Checker()
N = 4

def run_case(title, bank, layer, row, nevts, extra_args):
    aim = LokiAim.AimHelper(5000.0, N)
    nPacks = TU.getNumberOfPacksByBankId(bank)
    tube = layer * 2 * nPacks + row
    first = aim.getBankPixelOffset(bank) + tube * 7 * N
    aimed = list(range(first, first + nevts))
    print('=' * 100)
    print(f'{title}: bank {bank}, tube {tube}, aimed pixel ids {aimed[0]}..{aimed[-1]}')
    print('=' * 100)
    d = f'run_bank{bank}'
    os.makedirs(d, exist_ok=True)
    args = ['-lPL_Empty', f'-n{nevts}', f'aiming_straw_pixel_number={N}', f'analysis_straw_pixel_number={N}',
            f'aiming_bank_id={bank}', f'aiming_pixel_id_min={first}', 'rear_detector_distance_m=5'] + extra_args
    sim = subprocess.run(['sb_lokimasking_sim'] + args, cwd=d, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if not chk.check(sim.returncode == 0, f'simulation failed:\n{sim.stdout[-3000:]}'):
        return
    for line in sim.stdout.splitlines():
        if line.startswith(('Number of pixels in bank', 'Lowest pixel id', 'aiming_pixel_id_min')):
            print('sim:', line)
    ana = subprocess.run(['sb_lokimasking_ana', 'loki_masking.griff'], cwd=d, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if not chk.check(ana.returncode == 0, f'analysis failed:\n{ana.stdout[-3000:]}'):
        return
    for line in ana.stdout.splitlines():
        if line.startswith(('Created masking file', 'WARNING')):
            print('ana:', line)
    hc = sh.HistCollection(os.path.join(d, 'bcsloki_masking.shist'))
    def pixel_set(hname):
        c = np.asarray(hc.hist(hname).contents())  # shape (pixel in straw, straw id)
        return sorted(int(straw * N + j) for j, straw in np.argwhere(c > 0))
    entered = pixel_set('h_geantino_pixel_enter')
    entered_unmasked = pixel_set('h_geantino_pixel_enter_masked')
    print('entered pixel ids:', entered)
    print('entered without passing masks:', entered_unmasked)
    missing = sorted(set(aimed) - set(entered))
    chk.check(not missing, f'aimed pixels not entered by any geantino: {missing}')
    # decoded straw ids of the entered pixels (bank, tube, straw):
    straws = sorted({(aim.getBankId(p), aim.getTubeId(p, aim.getBankId(p)),
                      aim.getStrawId(p, aim.getBankId(p), aim.getTubeId(p, aim.getBankId(p)))) for p in entered})
    print('entered (bank, tube, straw):', straws)
    with open(os.path.join(d, f'bank{bank}_maskFile.xml')) as f:
        ids = [int(e) for e in re.search(r'<detids>(.*)</detids>', f.read(), re.S).group(1).split(',')]
    lo, hi = aim.getBankPixelOffset(bank), aim.getBankPixelOffset(bank + 1)
    expected_masked = [p + 1 for p in range(lo, hi) if p not in set(entered_unmasked)]
    chk.check(ids == expected_masked, 'mask file ids are not the complement (+1) of the unmasked entered pixels')
    print(f'mask file: {len(ids)} masked ids (bank pixel range {lo + 1}..{hi})')

run_case('Front left bank (vertical, upside down), back layer', 6, 3, 7, 14, [])
run_case('Mid top bank (horizontal, upside down), front layer', 1, 0, 3, 14, [])


def calibration_case():
    """The masking analysis uses the bank calibration of the simulation: with a calibration where the rear bank is
    moved by 40 mm along its tubes (2026-September-SAM-606 otherwise), the visible pixels of the analysis are those
    of the Converter exit points with that placement (emulating the analysis with the GRIFF file), and they differ
    from those with the nominal placement (so the test would see an analysis that ignores the calibration)."""
    import GriffDataRead
    from G4GeoLokiTests.testhelpers import captured_fd_output
    n = 16
    print('=' * 100)
    print(f'Rear bank moved by 40 mm along its tubes, {n} pixels per straw: the analysis uses the calibration')
    print('=' * 100)
    lines = []
    for line in LokiAim.bankCalibrationText('2026-September-SAM-606').splitlines():
        words = line.split()
        if words[:2] == ['bank', '0']:
            values = [float(v) for v in words[2:]]
            values[0:3] = [values[i] + 40.0 * values[3 + i] for i in range(3)]
            line = 'bank 0 ' + ' '.join(repr(v) for v in values)
        lines.append(line.replace('name 2026-September-SAM-606', 'name rear-moved'))
    d = 'run_rear_moved'
    os.makedirs(d, exist_ok=True)
    path = os.path.abspath(os.path.join(d, 'rear-moved.txt'))
    with open(path, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    first = (112 * 7 + 3) * n  # bank 0, front layer middle row, centre straw: 14 straws of geantinos
    nevts = 14 * 7 * n
    sim = subprocess.run(['sb_lokimasking_sim', '-lPL_Empty', f'-n{nevts}', f'aiming_straw_pixel_number={n}',
                          f'analysis_straw_pixel_number={n}', 'aiming_bank_id=0', f'aiming_pixel_id_min={first}',
                          'rear_detector_distance_m=5', f'bank_calibration={path}'],
                         cwd=d, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if not chk.check(sim.returncode == 0, f'simulation failed:\n{sim.stdout[-3000:]}'):
        return
    ana = subprocess.run(['sb_lokimasking_ana', 'loki_masking.griff'], cwd=d, stdout=subprocess.PIPE,
                         stderr=subprocess.STDOUT, text=True)
    if not chk.check(ana.returncode == 0, f'analysis failed:\n{ana.stdout[-3000:]}'):
        return
    hc = sh.HistCollection(os.path.join(d, 'bcsloki_masking.shist'))
    c = np.asarray(hc.hist('h_geantino_pixel_enter_masked').contents())
    visible = {int(straw * n + j) for j, straw in np.argwhere(c > 0)}

    def emulated(calibration):
        """The visible pixels of the analysis (pixel of the Converter exit point, before any absorber)."""
        pc = TU.PixelCalc(5000.0, n, 9, calibration)
        with captured_fd_output():
            dr = GriffDataRead.GriffDataReader(os.path.join(d, 'loki_masking.griff'))
        result = set()
        while dr.loopEvents():
            for trk in dr.primaryTracks:
                absorbed = False
                for seg in trk.segments:
                    name = seg.volumeName()
                    if not absorbed and ('BoronMask-' in name or name in ('B4CPanel', 'AlPanel')):
                        absorbed = True
                    elif name == 'Converter' and not absorbed:
                        st = seg.lastStep()
                        result.add(pc.getPixelId(seg.volumeCopyNumber(5), seg.volumeCopyNumber(3), seg.volumeCopyNumber(1),
                                                 st.postGlobalX(), st.postGlobalY(), st.postGlobalZ()))
        return result

    calibrated, nominal = emulated(path), emulated('nominal-geant4-geometry')
    chk.check(visible == calibrated, 'the visible pixels of the analysis are not those of the calibration')
    chk.check(calibrated != nominal, 'the calibration does not change the visible pixels (the test can not fail)')
    print(f'visible pixels of the analysis = those of the moved placement: {visible == calibrated}; '
          f'different from the nominal placement: {calibrated != nominal}')


calibration_case()

chk.finish()
