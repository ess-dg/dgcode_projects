#!/usr/bin/env python3

# PROTECTION TEST: the LOKI geometry will be changed to place the banks from the
# calibrated (surveyed) positions; the Larmor test setups of the same detectors
# (2020: GeoLarmorBCSExperiment; 2022: GeoBCSBanks with larmor_2022_experiment)
# must NOT change at all.
#
# Builds both Larmor geometries and lists every physical volume with its global
# position [mm, 6 decimals] and global orientation (rotation rows, 9 decimals).
# The volumes down to the packs (depth <= 2: world, banks, packs, masks, ...) are
# printed in full; the volumes inside each of them (tubes, straws, ...) are pinned
# by their number and a checksum of their listing, so a change shows up in the log
# diff at the pack it is in (and the repository limits the size of the log). The
# nominal LOKI geometry and the default one (the 2026-September-SAM-606 calibration;
# GeoBCSBanks, rear bank at 5 m) are pinned by the number of volumes and a checksum of
# the whole listing (their banks are checked in detail by the transition and calibration
# tests).
#
# (Each geometry is built in its own process: the two geometry modules cannot be
# imported into the same Python process.)

import hashlib
import subprocess
import sys

SETUPS = {
    'larmor2020': ('Larmor 2020 (GeoLarmorBCSExperiment, defaults)', 'GeoLarmorBCSExperiment', {}),
    'larmor2020_beamstop': ('Larmor 2020 (GeoLarmorBCSExperiment, withBeamstop)', 'GeoLarmorBCSExperiment',
                            dict(withBeamstop=True)),
    'larmor2022': ('Larmor 2022 (GeoBCSBanks, larmor_2022_experiment, rear 4.099 m, beamstop 1, calibration slits)',
                   'GeoBCSBanks', dict(rear_detector_distance_m=4.099, larmor_2022_experiment=True, beamstop_id=1,
                                       with_calibration_slits=True)),
    'loki': ('LOKI (GeoBCSBanks, bank_calibration=nominal-geant4-geometry)', 'GeoBCSBanks', dict(bank_calibration='nominal-geant4-geometry')),
    'loki_default': ('LOKI (GeoBCSBanks, defaults: bank_calibration=2026-September-SAM-606)', 'GeoBCSBanks', {}),
}

def listing(key):
    import importlib
    import G4GeoLokiTests.TestUtils as TU
    from G4GeoLokiTests.testhelpers import captured_fd_output, fmt
    title, module, params = SETUPS[key]
    geo = importlib.import_module(f'G4GeoLoki.{module}').create()
    for k, v in params.items():
        setattr(geo, k, v)
    with captured_fd_output():
        TU.construct_world(geo)
    lines = []
    for depth, name, copy, lvname, t, R in TU.world_tree():
        rot = ' '.join(fmt(x, 9) for row in R for x in row)
        lines.append((depth, f'{depth} {name} {copy} {lvname} ({fmt(t[0], 6)}, {fmt(t[1], 6)}, {fmt(t[2], 6)}) [{rot}]'))
    return title, lines

def summary(lines):
    """The volumes down to depth 2 in full; the content of each one as count + checksum."""
    out, inside = [], []
    def flush():
        if inside:
            out.append(f'    + {len(inside)} volumes inside, sha256 {hashlib.sha256(chr(10).join(inside).encode()).hexdigest()[:20]}')
            inside.clear()
    for depth, line in lines:
        if depth <= 2:
            flush()
            out.append(line)
        else:
            inside.append(line)
    flush()
    return out

if len(sys.argv) == 2:  # child process: one geometry
    title, lines = listing(sys.argv[1])
    if sys.argv[1].startswith('loki'):
        print(f'{title}: {len(lines)} volumes, sha256 of the listing '
              f'{hashlib.sha256(chr(10).join(line for _, line in lines).encode()).hexdigest()}')
    else:
        print(f'{title}: {len(lines)} volumes')
        print('\n'.join(summary(lines)))
    sys.exit(0)

failed = False
for key in SETUPS:
    r = subprocess.run([sys.executable, sys.argv[0], key], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    print('=' * 90)
    print(r.stdout.rstrip())
    if r.returncode != 0:
        print(f'TEST FAILED: building {key} failed')
        failed = True
sys.exit(1 if failed else 0)
