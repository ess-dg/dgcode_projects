#!/usr/bin/env python3

# Consistency of the BUILT Geant4 geometry (GeoBCSBanks) with the AimHelper
# pixel centres and with the hit -> pixel mapping of the analysis programs.
#
# The geometry is constructed directly (no run manager / physics) and a
# G4Navigator is used to locate AimHelper pixel centres. For each pixel it is
# checked that:
#   * the point lies in the CountingGas of a straw, and the touchable history
#     is exactly the volume chain the analysis programs rely on
#     (CountingGas/Converter/StrawWall/EmptyTube/TubeWall/EmptyPackBox/Bank/World;
#     from a Converter segment: copy number depth 1 = straw, 3 = tube, 5 = bank),
#   * the StrawWall/TubeWall/Bank copy numbers equal the straw/tube/bank ids
#     decoded from the pixel id by AimHelper (Converter copy number = straw+100),
#   * the point is on the straw axis (local x,y = 0) at the expected position
#     along the straw (local z),
#   * PixelatedBanks::getPixelId(bank, tube copy no., straw copy no., x, y)
#     returns the pixel id (for a bank calibration: the 3D getPixelId(..., x, y, z),
#     as done in LOKI/app_ana and LokiMasking/app_ana).
# This is done for the first, middle and last pixel of EVERY straw (nominal geometry unless
# a bank calibration is given), for the nominal geometry and the 2026-September-SAM-606
# bank calibration (survey-based, not axis-aligned banks); a sample of pixels is
# printed (ids, copy numbers, global position, local position, global straw
# axis direction) to pin the current geometry.

import math
import G4GeoLoki.GeoBCSBanks as GEO
import G4GeoLoki.LokiAimHelper as LokiAim
import G4GeoLokiTests.TestUtils as TU
from G4GeoLokiTests.testhelpers import (captured_fd_output, fmt, fmtvec, sample_pixels,
                                        NSTRAWS, Checker)

chk = Checker()
NOMINAL = 'nominal-geant4-geometry'  # (explicit: the default of the geometry is the 2026-September-SAM-606 calibration)

EXPECTED_CHAIN = ['CountingGas', 'Converter', 'StrawWall', 'EmptyTube', 'TubeWall', 'EmptyPackBox', 'Bank', 'World']

def expected_local_z(bank, j, N):
    L = TU.getStrawLengthByBankId(bank)
    z = -0.5 * L + (j + 0.5) * L / N
    return -z if TU.areTubesInverselyNumbered(bank) else z

def check_pixel(aim, pc, pid, N, verbose, calibrated=False):
    b = aim.getBankId(pid)
    t = aim.getTubeId(pid, b)
    s = aim.getStrawId(pid, b, t)
    j = pid % N
    c = aim.getPixelCentreCoordinates(pid)
    hist, loc, axis, _ = TU.locate(*c)
    names = [h[0] for h in hist]
    copies = [h[1] for h in hist]
    ok = chk.check(names == EXPECTED_CHAIN, f'pixel {pid}: unexpected volume chain {names}')
    if ok:
        chk.check(copies[1] == s + 100 and copies[2] == s and copies[4] == t and copies[6] == b,
                  f'pixel {pid}: copy numbers {copies} vs bank {b} tube {t} straw {s}')
        chk.check(abs(loc[0]) < 1e-6 and abs(loc[1]) < 1e-6 and abs(loc[2] - expected_local_z(b, j, N)) < 1e-6,
                  f'pixel {pid}: local position {loc}, expected z {expected_local_z(b, j, N)}')
        # hit -> pixel id exactly as in the analysis (copy numbers from the touchable):
        if not calibrated:
            chk.check(pc.getPixelId(copies[6], copies[4], copies[2], c[0], c[1]) == pid,
                      f'pixel {pid}: getPixelId from touchable -> {pc.getPixelId(copies[6], copies[4], copies[2], c[0], c[1])}')
        else:
            chk.check(pc.getPixelId3D(copies[6], copies[4], copies[2], *c) == pid,
                      f'pixel {pid}: getPixelId (3D) from touchable -> {pc.getPixelId3D(copies[6], copies[4], copies[2], *c)}')
    if verbose:
        print(f'{pid:8} {b:4} {t:4} {s:5} {j:5}  bank/tube/straw copyNo: {copies[6]:2} {copies[4]:4} {copies[2]:2}'
              f'  centre {fmtvec(c,4)}  local {fmtvec(loc,4)}  straw axis {fmtvec(axis,6)}')

def run(title, geopars, rear_mm, N, nbanks):
    geopars = dict(bank_calibration=NOMINAL, **geopars) if 'bank_calibration' not in geopars else geopars
    print('=' * 100)
    print(title)
    print('=' * 100)
    geo = GEO.create()
    for k, v in geopars.items():
        setattr(geo, k, v)
    with captured_fd_output() as lines:
        TU.construct_world(geo)
    nok = sum(1 for l in lines if l.startswith('Checking overlaps') and l.rstrip().endswith('OK!'))
    print(f'(geometry built, {nok} placements passed the overlap check)')
    calibration = geopars['bank_calibration'] if geopars['bank_calibration'] != NOMINAL else None
    if calibration:
        aim = LokiAim.AimHelper(rear_mm, N, nbanks, calibration)
        pc = TU.PixelCalc(rear_mm, N, nbanks, calibration)
    else:
        aim = LokiAim.AimHelper(rear_mm, N) if nbanks == 9 else LokiAim.AimHelper(rear_mm, N, nbanks)
        pc = TU.PixelCalc(rear_mm, N, nbanks)
    # full volume chain once:
    c0 = aim.getPixelCentreCoordinates(0)
    print('Volume chain at pixel 0 (name:copyNo):', ' / '.join(f'{h[0]}:{h[1]}' for h in TU.locate(*c0)[0]))
    print(f'{"pixelId":>8} {"bank":>4} {"tube":>4} {"straw":>5} {"pix":>5}')
    for (b, t, s, j, pid) in sample_pixels(aim, N, range(nbanks)):
        check_pixel(aim, pc, pid, N, True, bool(calibration))
    n0 = chk.nchecks
    for b in range(nbanks):
        for t in range(TU.getNumberOfTubes(b)):
            for s in range(NSTRAWS):
                base = aim.getBankPixelOffset(b) + (t * NSTRAWS + s) * N
                for j in (0, N // 2, N - 1):
                    check_pixel(aim, pc, base + j, N, False, bool(calibration))
    print(f'All straws (first/middle/last pixel): {chk.nchecks - n0} checks done, failures so far: {chk.nfail}')

run('Nominal geometry: rear 5 m, 256 pixels/straw', dict(), 5000.0, 256, 9)
run('Rear 10 m, beamstop 3, calibration slits, 512 pixels/straw',
    dict(rear_detector_distance_m=10.0, beamstop_id=3, with_calibration_slits=True), 10000.0, 512, 9)
run('Bank calibration 2026-September-SAM-606: rear 5 m, 256 pixels/straw',
    dict(bank_calibration='2026-September-SAM-606'), 5000.0, 256, 9)
run('Bank calibration 2026-September-SAM-606: rear 8 m, calibration slits, 64 pixels/straw',
    dict(bank_calibration='2026-September-SAM-606', rear_detector_distance_m=8.0, with_calibration_slits=True),
    8000.0, 64, 9)

chk.finish()
