#!/usr/bin/env python3

# Small end-to-end test of the neutron simulation + analysis chain, checking the
# pixel ids assigned by the production analysis (sb_loki_ana, i.e.
# LOKI/app_ana: DetHitApproximation hit position + copy numbers ->
# PixelatedBanks::getPixelId -> detectionEvents.mcpl).
#
# Neutrons (6 Aa, fixed seed, QGSP_BIC_HP) are shot from the sample position
# at the centres of 2 pixels (pixel 5 and 10 of 16, i.e. on both sides of the
# straw centre) of the central straw of a front-layer tube in a middle row of
# each of the 9 banks, 20 neutrons per target. 16 pixels per straw are used, so
# that the hit position approximation can not move hits across pixel borders.
# (Targets near the straw ends are avoided on purpose: they are shadowed by
# other banks, e.g. the outer parts of the rear bank by the mid banks, and the
# ends of the vertical front banks by the front top/bottom banks and the
# triangular masks.)
#
# Checks:
#  * The detection events written by the analysis are the conversion point pixels of the converted primary
#    neutrons (pixel computed from the GRIFF conversion point and copy numbers with PixelatedBanks::getPixelId), in
#    event order (the analysis writes one detection per event with a hit). 16 pixels per straw are used, so that the
#    hit position approximation can not move hits across pixel borders.
#  * Conversions in the target bank happen at the targeted pixel position along the straw (except for neutrons
#    scattered before conversion).
#  * Every target gets detections in the targeted bank at the targeted pixel position along the straw (so all 9
#    banks are exercised).
#  * The analysis uses the calibration: with a calibration where the rear bank is moved by 40 mm along its tubes (towards the first pixel end)
#    (2026-September-SAM-606 otherwise; the few mm of the SAM-606 placements along the tubes do not change pixel ids
#    of 31-75 mm long pixels), the rear bank conversions are in other pixels than with the nominal placement, and
#    their detections are at the calibrated pixels.
# Only the results of the checks are printed (the numbers of events and hits of the Monte Carlo are not pinned).
# Run for the nominal geometry, the 2026-September-SAM-606 bank calibration and the moved one (geometry, aiming and
# analysis with the calibration).

import os
import subprocess
import sys
import mcpl
import GriffDataRead
import G4GeoLoki.LokiAimHelper as LokiAim
import G4GeoLokiTests.TestUtils as TU
from G4GeoLokiTests.testhelpers import Checker, NBANKS, NSTRAWS, captured_fd_output

chk = Checker()
NOMINAL = 'nominal-geant4-geometry'  # (explicit: the default of the geometry is the 2026-September-SAM-606 calibration)

REPEAT = 20
REAR = 5000.0
def run(calibration, N):
    """calibration: the bank_calibration of the geometry, the aiming and the analysis; N: pixels per straw"""
    tolerance = 0  # [pixels] detection vs conversion point
    print('=' * 90)
    print(f'bank_calibration={os.path.basename(calibration)}, {N} pixels per straw')
    calibration_args = [f'bank_calibration={calibration}', f'aiming_bank_calibration={calibration}']
    aim = LokiAim.AimHelper(REAR, N, NBANKS, calibration)
    pc = TU.PixelCalc(REAR, N, NBANKS, calibration)
    pc_nominal = TU.PixelCalc(REAR, N, NBANKS, NOMINAL)

    targets = []
    for b in range(NBANKS):
        nPacks = TU.getNumberOfPacksByBankId(b)
        tube = 0 * 2 * nPacks + nPacks  # layer 0 (front), middle row
        for j in (5, 10):  # 0.19 L from the straw centre (the moved rear bank: 0.23 L; further out it is shadowed)
            targets.append(aim.getBankPixelOffset(b) + (tube * NSTRAWS + 3) * N + j)

    def decode(p):
        b = aim.getBankId(p)
        t = aim.getTubeId(p, b)
        return (b, t, aim.getStrawId(p, b, t), p % N)

    print('Targets (pixelId: bank, tube, straw, pixel):', ', '.join(f'{p}: {decode(p)}' for p in targets))
    nevts = len(targets) * REPEAT
    sim = subprocess.run(['sb_g4geolokitests_simpixeltargets', '-lQGSP_BIC_HP', f'-n{nevts}', '--seed=123456789',
                          f'target_pixel_ids={",".join(map(str, targets))}', f'repeat={REPEAT}',
                          f'rear_detector_distance_mm={REAR}', 'rear_detector_distance_m=5.0',
                          f'aiming_straw_pixel_number={N}', f'analysis_straw_pixel_number={N}',
                          'neutron_wavelength_aangstrom=6.0'] + calibration_args,
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if sim.returncode != 0:
        print(sim.stdout[-5000:])
        print('TEST FAILED: simulation failed')
        sys.exit(1)
    ana = subprocess.run(['sb_loki_ana', 'pixeltargets.griff'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if ana.returncode != 0:
        print(ana.stdout[-5000:])
        print('TEST FAILED: analysis failed')
        sys.exit(1)
    for line in ana.stdout.splitlines():
        if line.startswith(('Total number of pixels', 'Number of pixels per straw', 'Number of straws')):
            print('ana:', line)

    # Conversion points from the GRIFF file:
    conv = []  # (event index, target pixel, conversion pixel, conversion pixel with the nominal placement)
    nscattered = 0
    with captured_fd_output():  # swallow the 'GriffDataReader opened file' message (stable logs)
        dr = GriffDataRead.GriffDataReader('pixeltargets.griff')
    ievt = 0
    while dr.loopEvents():
        target = targets[ievt // REPEAT]
        for trk in dr.primaryTracks:
            if trk.pdgCode() != 2112:
                continue
            seg = trk.lastSegment()
            if seg.volumeName() != 'Converter':
                continue
            st = seg.lastStep()
            names = [seg.volumeName(d) for d in range(7)]
            chk.check(names == ['Converter', 'StrawWall', 'EmptyTube', 'TubeWall', 'EmptyPackBox', 'Bank', 'World'],
                      f'unexpected volume chain {names}')
            b, t, s = seg.volumeCopyNumber(5), seg.volumeCopyNumber(3), seg.volumeCopyNumber(1)
            position = (st.postGlobalX(), st.postGlobalY(), st.postGlobalZ())
            p = pc.getPixelId(b, t, s, *position)
            conv.append((ievt, target, p, pc_nominal.getPixelId(b, t, s, *position)))
            tb, _, _, tj = decode(target)
            if b == tb and abs(p % N - tj) > tolerance:
                nscattered += 1
        ievt += 1
    chk.check(ievt == nevts, f'number of events in griff file {ievt} != {nevts}')

    detections = [int(round(pt.ekin)) for pt in mcpl.MCPLFile('detectionEvents.mcpl').particles]

    # Align detections (event order) with the conversion pixels (the same straw, within the tolerance):
    k = 0
    matched = []  # (target, detected pixel, conversion pixel, nominal conversion pixel)
    for (e, target, p, p_nominal) in conv:
        if k < len(detections) and detections[k] // N == p // N and abs(detections[k] - p) <= tolerance:
            matched.append((target, detections[k], p, p_nominal))
            k += 1
    chk.check(k == len(detections) and k > 0,
              f'{len(detections) - k} detections do not match the conversion point pixels (first unmatched: {detections[k:k+5]})')
    print(f'All detections are at the pixels of conversion points (within {tolerance} pixel along the straw): '
          f'{k == len(detections) and k > 0}')
    chk.check(nscattered <= 0.1 * len(conv), f'{nscattered} of {len(conv)} conversions away from the targeted pixel')
    print(f'Conversions in the target bank at the targeted pixel position (except for a few scattered neutrons): '
          f'{nscattered <= 0.1 * len(conv)}')

    missing = []
    for target in targets:
        det = [d for (t, d, p, pn) in matched if t == target]
        tb, tt, ts, tj = decode(target)
        if not any(decode(d)[0] == tb and abs(decode(d)[3] - tj) <= tolerance for d in det):
            missing.append(target)
    chk.check(not missing, f'no detection in the targeted bank at the targeted pixel position for the targets {missing}')
    print(f'Every target has detections in its bank at the targeted pixel position: {not missing}')

    return matched


def moved_rear_bank(shift_mm):
    """A calibration file: 2026-September-SAM-606 with the rear bank moved along its tubes."""
    lines = []
    for line in LokiAim.bankCalibrationText('2026-September-SAM-606').splitlines():
        words = line.split()
        if words[:2] == ['bank', '0']:
            values = [float(v) for v in words[2:]]
            values[0:3] = [values[i] + shift_mm * values[3 + i] for i in range(3)]
            line = 'bank 0 ' + ' '.join(repr(v) for v in values)
        lines.append(line.replace('name 2026-September-SAM-606', 'name sam606-rear-moved'))
    path = os.path.abspath('bank_calibration_sam606-rear-moved.txt')
    with open(path, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    return path


run(NOMINAL, 16)
run('2026-September-SAM-606', 16)
matched = run(moved_rear_bank(-40.0), 16)
moved = [(d, p, pn) for (t, d, p, pn) in matched if p != pn]
at_calibrated = all(d == p for d, p, pn in moved)
chk.check(moved and at_calibrated, f'the analysis does not use the calibration ({len(moved)} moved detections)')
print('Detections whose conversion pixel differs from the nominal one: > 0: '
      f'{len(moved) > 0}, all at the calibrated pixel: {at_calibrated}')

chk.finish()
