#!/usr/bin/env python3

# TRANSITION TEST (nominal geometry, ALL pixels, long): for every pixel of the
# geometry, compares the current implementation with the ORIGINAL one frozen
# in G4GeoLokiTests.Legacy (a copy of the pre-BankTransform code):
#
#   * AimHelper::getPixelCentreCoordinates (now via BcsBanks::getBankTransform)
#     vs the original AimHelper chain of axis rotations: largest deviation;
#   * the pixel id of the current 3D PixelatedBanks::getPixelId(bank, tube,
#     straw, x, y, z) (bank-local position along the straw, used by the analyses)
#     and of the original (x, y) version, vs the expected pixel id, at the pixel
#     centre, at +-0.49 / +-0.51 pixel pitch along the straw (within the straw)
#     and 3 mm across the straw in four directions.
#
# Setups: LOKI with 256 and 512 pixels per straw, rear bank at 5, 7.3 and 10 m,
# new and old tube numbering; Larmor 2022 (one bank, 512 pixels per straw).

from G4GeoLokiTests.Legacy import compare_all
from G4GeoLokiTests.testhelpers import Checker

chk = Checker()
setups = [  # (rear [mm], pixels per straw, banks, old tube numbering, Larmor 2022)
    (5000.0, 256, 9, False, False),
    (5000.0, 256, 9, True, False),
    (5000.0, 512, 9, False, False),
    (7300.0, 256, 9, False, False),
    (10000.0, 512, 9, True, False),
    (4099.0, 512, 1, False, True),
    (4099.0, 512, 1, True, True),
]
for rear, n, nbanks, old, larmor in setups:
    npix, worst, worst_pixel, nchecks, nfail, first_fail = compare_all(rear, n, nbanks, old, larmor)
    print(f'rear {rear/1000} m, {n} px/straw, {nbanks} banks, {"old" if old else "new"} numbering, '
          f'Larmor 2022 {larmor}: {npix} pixels, largest pixel centre deviation from the original '
          f'{"< 1e-9" if worst < 1e-9 else worst} mm, {nchecks} pixel id checks, {nfail} failures')
    chk.check(worst < 1e-9, f'  pixel centres deviate by {worst} mm (pixel {worst_pixel})')
    chk.check(nfail == 0, f'  {nfail} pixel id failures, first at pixel {first_fail}')
    chk.nchecks += nchecks + npix - 2

chk.finish()
