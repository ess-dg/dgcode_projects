#!/usr/bin/env python3

# Dense overlap check of the volumes placed in the world of GeoBCSBanks (banks, triangular boron
# masks): 500k random surface points of every world volume are
# tested against every other world volume (TestUtils.dense_world_overlaps; the construction-time
# check of test_geo_construct_overlaps uses 1000 points per placement). Any point deeper than
# 1e-6 mm inside another volume fails the test. The banks 6 and 8 overlap the boxes of the banks
# 5 and 7, which is resolved by their notch; with a bank calibration the triangular masks must
# follow banks 5 and 7.
#
# Also checked: 100k random surface points of every volume inside a bank (packs, boron masks,
# calibration masks, beamstop) are inside the bank solid (for the banks 6 and 8: not in the notch);
# printed: the smallest distance of the content of banks 6 and 8 from their notch.
#
# Configurations: the nominal geometry and the 2026-September-SAM-606 bank calibration (with
# and without beamstop / calibration slits).
#
# Sensitivity / notch checks with calibration files made here from the nominal placement:
#  * bank 2 moved 400 mm towards bank 4: the overlap must be found;
#  * bank 5 moved 3 mm along the beam: its box reaches outside the nominal notch of bank 6, so
#    the notch is enlarged (to the overlap region + 1 mm) and there must be no overlap, also not
#    of the packs of bank 6 with the bank (containment check);
#  * bank 5 moved 60 mm along the beam: the notch would have to cut into the packs of bank 6, so the
#    geometry construction must stop with an error.

import os
import numpy as np
import G4GeoLoki.GeoBCSBanks as GEO
import G4GeoLoki.LokiAimHelper as LokiAim
import G4GeoLokiTests.TestUtils as TU
from G4GeoLokiTests.testhelpers import Checker, captured_fd_output, NSTRAWS

chk = Checker()
NOMINAL = 'nominal-geant4-geometry'  # (explicit: the default of the geometry is the 2026-September-SAM-606 calibration)

NPOINTS = 500000
TOLERANCE = 1e-6  # mm

def build(pars):
    geo = GEO.create()
    for k, v in pars.items():
        setattr(geo, k, v)
    with captured_fd_output() as lines:
        TU.construct_world(geo)
    problems = [l for l in lines if (l.startswith('Checking overlaps') and not l.rstrip().endswith('OK!'))
                or 'G4Exception' in l]
    # 'GeoBCSBanks: bank 6: notch enlarged for bank_calibration=<name> to ...' -> 'bank 6: notch enlarged'
    notes = [l.split('GeoBCSBanks: ', 1)[1].split(' for bank_calibration')[0] for l in lines if 'notch enlarged' in l]
    return problems, notes

def run(title, pars, expect_overlap=False):
    pars = dict(bank_calibration=NOMINAL, **pars) if 'bank_calibration' not in pars else pars
    problems, notes = build(pars)
    overlaps = TU.dense_world_overlaps(NPOINTS, TOLERANCE)
    outside = TU.dense_bank_containment(100000, TOLERANCE)
    print(f'{title}: {len(TU.world_daughters())} world volumes, construction check problems: {len(problems)}, '
          f'dense check overlaps: {len(overlaps)}, bank content outside its bank: {len(outside)}'
          + (f', {"; ".join(notes)}' if notes else ''))
    for a, b, n, depth in overlaps:
        print(f'    {a} in {b}: {n} points, up to {depth:.1f} mm deep')
    for bank, daughter, n, distance in outside:
        print(f'    bank {bank}: {daughter} outside the bank: {n} points, up to {distance:.1f} mm')
    if expect_overlap:
        chk.check(overlaps, f'{title}: the overlap was not found')
    else:
        chk.check(not overlaps and not problems and not outside, f'{title}: overlaps {overlaps} {outside} {problems[:5]}')
    pc = TU.PixelCalc(5000.0, 256, 9, pars.get('bank_calibration', 'nominal-geant4-geometry'))
    clearances = []
    for b in (6, 8):
        centre, half, _ = pc.getBankNotch(b)
        distance, closest = TU.bank_daughters_distance_to_box(b, list(centre), list(half), 100000)
        chk.check(distance > 0, f'{title}: bank {b}: the content touches the notch')
        clearances.append(f'bank {b} {distance:.1f} mm ({closest.split(":")[0]})')
    print('    smallest distance of the bank content from the notch: ' + ', '.join(clearances))
    return notes

run('nominal, defaults', dict())
run('nominal, rear 10 m, beamstop 3, calibration slits', dict(rear_detector_distance_m=10.0, beamstop_id=3, with_calibration_slits=True))
run('2026-September-SAM-606, defaults', dict(bank_calibration='2026-September-SAM-606'))
run('2026-September-SAM-606, rear 10 m, beamstop 3, calibration slits',
    dict(bank_calibration='2026-September-SAM-606', rear_detector_distance_m=10.0, beamstop_id=3, with_calibration_slits=True))

# calibration files from the nominal placement, with one bank moved
def nominal_bank_line(b):
    # (a new AimHelper each time: the pixels per straw are shared by all PixelatedBanks objects)
    aim = LokiAim.AimHelper(5000.0, 2)
    T = 2 * TU.getNumberOfPacksByBankId(b)
    def centre(tube, j):
        return np.array(aim.getPixelCentreCoordinates(aim.getBankPixelOffset(b) + (tube * NSTRAWS + 3) * 2 + j))
    u = centre(0, 0) - centre(0, 1)
    u /= np.linalg.norm(u)
    first, last = (centre(0, 0) + centre(0, 1)) / 2, (centre(T - 1, 0) + centre(T - 1, 1)) / 2
    w = first - last
    w -= np.dot(w, u) * u
    w /= np.linalg.norm(w)
    n = np.cross(u, w)
    return (first + last) / 2 - n * TU.getTubeOuterRadius(), u, w, n

def moved_calibration(name, bank, shift):
    path = os.path.abspath(f'bank_calibration_{name}.txt')
    lines = ['loki_bank_calibration 1', f'name {name}']
    for b in range(1, 9):
        F, u, w, n = nominal_bank_line(b)
        if b == bank:
            F = F + np.array(shift)
        lines.append(f'bank {b} ' + ' '.join(f'{v:.17g}' for v in (*F, *u, *w, *n)))
    with open(path, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    return path

run('bank 2 moved 400 mm towards bank 4 (must overlap)', dict(bank_calibration=moved_calibration('bank2-moved', 2, (-400.0, 0.0, 0.0))),
    expect_overlap=True)
notes = run('bank 5 moved 3 mm along the beam (notch of bank 6 enlarged)',
            dict(bank_calibration=moved_calibration('bank5-moved', 5, (0.0, 0.0, 3.0))))
chk.check(any(note.startswith('bank 6: notch enlarged') for note in notes), 'the notch of bank 6 was not enlarged')
pc = TU.PixelCalc(5000.0, 256, 9, moved_calibration('bank5-moved', 5, (0.0, 0.0, 3.0)))
centre, half, is_nominal = pc.getBankNotch(6)
points = np.array(pc.getBankBoxOverlapPoints(6, 5))
lo, hi = np.array(centre) - np.array(half), np.array(centre) + np.array(half)
inside = bool(np.all(points >= lo) and np.all(points <= hi))
margin = np.min(np.minimum(points - lo, hi - points))
print(f'    bank 6 notch: centre ({", ".join(f"{v:.2f}" for v in centre)}) mm, half sizes ({", ".join(f"{v:.2f}" for v in half)}) mm, '
      f'contains the overlap region: {inside} (margin {margin:.2f} mm)')
chk.check(not is_nominal and inside and margin >= 1.0 - 1e-9, f'enlarged notch {centre} {half}: margin {margin}')

# a collision the notch can not resolve: the construction must stop with an error
colliding = moved_calibration('bank5-colliding', 5, (0.0, 0.0, 60.0))
geo = GEO.create()
geo.bank_calibration = colliding
error = None
with captured_fd_output():
    try:
        TU.construct_world(geo)
    except Exception as e:
        error = str(e)
chk.check(error is not None and 'would cut into' in error, f'bank 5 moved 60 mm: no error ({error})')
print('bank 5 moved 60 mm along the beam: construction stopped:', error.split(': ', 1)[1].replace(colliding, '<file>') if error else 'NO')

chk.finish()
