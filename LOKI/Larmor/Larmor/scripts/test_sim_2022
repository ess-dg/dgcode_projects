#!/usr/bin/env bash

# The Larmor 2022 flood source simulation (no interactions) and its analysis.
# Each step must succeed (its output is in <step>.log); the log of the test is a summary of the output files
# (LOKI.OutputSummary: histograms, detection events, mask files).

run() { local name=$1; shift; "$@" > $name.log 2>&1 || { tail -40 $name.log; echo "TEST FAILED: $name"; exit 1; }; }
run sim sb_larmor_sim_2022 rear_detector_distance_m=4.099 analysis_straw_pixel_number=512 beamstop_id=0 event_gen=flood gen_x_offset_meters=0.005 nominal_source_sample_distance_meters=25.61 -lPL_Empty
run ana sb_larmor_ana_2022 lokisim.griff
python3 -m LOKI.OutputSummary
