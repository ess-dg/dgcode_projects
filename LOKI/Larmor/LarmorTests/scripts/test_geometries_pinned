#!/usr/bin/env python3

# Pins the Larmor geometries (Larmor/GeoLarmor2020, Larmor/GeoLarmor2022): they must NOT change.
#
# Builds the geometries and lists every physical volume with its global position [mm, 6 decimals] and global
# orientation (rotation rows, 9 decimals). The volumes down to the packs (depth <= 2: world, banks, packs, masks,
# ...) are printed in full; the volumes inside each of them (tubes, straws, ...) are pinned by their number and a
# checksum of their listing, so a change shows up in the log diff at the pack it is in. (The same listing as of
# G4GeoLokiTests/test_larmor_geometries_pinned before the Larmor geometries were moved to the Larmor package.)
#
# (Each geometry is built in its own process.)

import hashlib
import subprocess
import sys

SETUPS = {
    'larmor2020': ('Larmor 2020 (GeoLarmor2020, defaults)', 'GeoLarmor2020', {}),
    'larmor2020_beamstop': ('Larmor 2020 (GeoLarmor2020, withBeamstop)', 'GeoLarmor2020', dict(withBeamstop=True)),
    'larmor2022': ('Larmor 2022 (GeoLarmor2022, rear 4.099 m, beamstop 1, calibration slits)',
                   'GeoLarmor2022', dict(rear_detector_distance_m=4.099, beamstop_id=1, with_calibration_slits=True)),
    'larmor2022_old': ('Larmor 2022 (GeoLarmor2022, old tube numbering)', 'GeoLarmor2022', dict(old_tube_numbering=True)),
}

def listing(key):
    import importlib
    import G4GeoLokiTests.TestUtils as TU
    from G4GeoLokiTests.testhelpers import captured_fd_output, fmt
    title, module, params = SETUPS[key]
    geo = importlib.import_module(f'Larmor.{module}').create()
    for k, v in params.items():
        setattr(geo, k, v)
    with captured_fd_output():
        TU.construct_world(geo)
    lines = []
    for depth, name, copy, lvname, t, R in TU.world_tree():
        rot = ' '.join(fmt(x, 9) for row in R for x in row)
        lines.append((depth, f'{depth} {name} {copy} {lvname} ({fmt(t[0], 6)}, {fmt(t[1], 6)}, {fmt(t[2], 6)}) [{rot}]'))
    return title, lines

def summary(lines):
    """The volumes down to depth 2 in full; the content of each one as count + checksum."""
    out, inside = [], []
    def flush():
        if inside:
            out.append(f'    + {len(inside)} volumes inside, sha256 {hashlib.sha256(chr(10).join(inside).encode()).hexdigest()[:20]}')
            inside.clear()
    for depth, line in lines:
        if depth <= 2:
            flush()
            out.append(line)
        else:
            inside.append(line)
    flush()
    return out

if len(sys.argv) == 2:  # child process: one geometry
    title, lines = listing(sys.argv[1])
    print(f'{title}: {len(lines)} volumes')
    print('\n'.join(summary(lines)))
    sys.exit(0)

failed = False
for key in SETUPS:
    r = subprocess.run([sys.executable, sys.argv[0], key], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    print('=' * 90)
    print(r.stdout.rstrip())
    if r.returncode != 0:
        print(f'TEST FAILED: building {key} failed')
        failed = True
sys.exit(1 if failed else 0)
